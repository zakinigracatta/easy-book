rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isBusinessOwner(businessId) {
      return isOwnerAccount() &&
        (
          businessId == request.auth.uid ||
          (
            exists(/databases/$(database)/documents/businesses/$(businessId)) &&
            (
              ('owner_id' in get(/databases/$(database)/documents/businesses/$(businessId)).data && get(/databases/$(database)/documents/businesses/$(businessId)).data.owner_id == request.auth.uid) ||
              ('ownerId' in get(/databases/$(database)/documents/businesses/$(businessId)).data && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid)
            )
          )
        );
    }

    function validExpenseCategory(category) {
      return category in [
        'rent',
        'salaries',
        'commissions',
        'utilities',
        'internetPhone',
        'supplies',
        'equipment',
        'maintenance',
        'cleaningLaundry',
        'marketing',
        'licensing',
        'insurance',
        'paymentFees',
        'easyBookFees',
        'taxes',
        'transport',
        'other'
      ];
    }

    function validExpenseFrequency(frequency) {
      return frequency in ['oneTime', 'monthly', 'yearly'];
    }

    function validExpenseData(businessId) {
      return request.resource.data.keys().hasOnly([
          'businessId',
          'category',
          'description',
          'amount',
          'expenseDate',
          'paymentMethod',
          'supplier',
          'receiptUrl',
          'notes',
          'frequency',
          'isActive',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'businessId',
          'category',
          'description',
          'amount',
          'expenseDate',
          'paymentMethod',
          'frequency',
          'isActive',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.businessId == businessId &&
        request.resource.data.category is string &&
        validExpenseCategory(request.resource.data.category) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 300 &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.expenseDate is timestamp &&
        request.resource.data.paymentMethod is string &&
        request.resource.data.paymentMethod.size() > 0 &&
        request.resource.data.frequency is string &&
        validExpenseFrequency(request.resource.data.frequency) &&
        request.resource.data.isActive is bool &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        (!('supplier' in request.resource.data) || request.resource.data.supplier is string) &&
        (!('receiptUrl' in request.resource.data) || request.resource.data.receiptUrl is string) &&
        (!('notes' in request.resource.data) || request.resource.data.notes is string);
    }

    // User Devices
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // User Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if false;
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && resource != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'isRead']);
      allow delete: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isUser(userId);

      allow create: if isUser(userId)
                    && request.path == /databases/$(database)/documents/users/$(userId)
                    && request.resource.data.keys().hasAny(['email', 'role'])
                    && request.resource.data.id == userId
                    && ('email' in request.auth.token)
                    && request.resource.data.email == request.auth.token.email
                    && (request.resource.data.role == 'customer' || request.resource.data.role == 'owner');

      allow update: if isUser(userId)
                    && request.path == /databases/$(database)/documents/users/$(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email']);
    }

    // Businesses Collection & Subcollections
    match /businesses/{businessId} {
      allow read: if true;

      allow create: if isOwnerAccount() &&
        (businessId == request.auth.uid ||
         request.resource.data.ownerId == request.auth.uid ||
         request.resource.data.owner_id == request.auth.uid);

      allow update: if isBusinessOwner(businessId);

      allow delete: if isBusinessOwner(businessId);

      // Services Subcollection
      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // Staff Subcollection
      match /staff/{staffId} {
        allow read: if true;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // PRIVATE OWNER FINANCE: employees and customers have no read/write access.
      match /expenses/{expenseId} {
        allow read: if isBusinessOwner(businessId);

        allow create: if isBusinessOwner(businessId)
                      && validExpenseData(businessId)
                      && request.resource.data.isActive == true
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;

        allow update: if isBusinessOwner(businessId)
                      && resource != null
                      && validExpenseData(businessId)
                      && request.resource.data.businessId == resource.data.businessId
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.updatedAt == request.time;

        // Financial history is archived, never hard-deleted from untrusted clients.
        allow delete: if false;
      }

      // Offers Subcollection
      match /offers/{offerId} {
        allow read: if true;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // Gallery Subcollection
      match /gallery/{imageId} {
        allow read: if true;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // Customer Reviews: public read; owner can only add/edit the business reply fields.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, delete: if false;
        allow update: if isBusinessOwner(businessId)
                      && resource != null
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['businessReply', 'businessReplyAt']);
      }

      // Owner Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, update: if isBusinessOwner(businessId);
        allow create, delete: if isBusinessOwner(businessId);
      }

      // Staff Time-offs Subcollection
      match /timeOffs/{timeOffId} {
        allow read, create, update, delete: if isBusinessOwner(businessId);
      }

      // PRIVATE OWNER CUSTOMER NOTES SUBCOLLECTION (CUSTOMERS STRICTLY DENIED)
      match /customerNotes/{customerId} {
        allow read, write: if isBusinessOwner(businessId);
      }

      match /bookingNotes/{bookingId} {
        allow read, write: if isBusinessOwner(businessId);
      }
    }

    // Slot Locks Collection (Public Non-Sensitive Availability Queries; Untrusted Client Writes Denied)
    match /booking_slots/{slotId} {
      allow read, get, list: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Bookings Collection (Untrusted Client Direct Writes Denied; Cloud Functions Admin SDK Execution Canonical)
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isBusinessOwner(resource.data.businessId)
      );

      allow create, update, delete: if false;
    }
  }
}
