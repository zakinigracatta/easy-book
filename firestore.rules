rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerAccount() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isBusinessOwner(businessId) {
      let biz = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      return isAuthenticated() && (
        (isOwnerAccount() && (
          ('owner_id' in biz && biz.owner_id == request.auth.uid) ||
          ('ownerId' in biz && biz.ownerId == request.auth.uid)
        )) ||
        ('owner_id' in biz && biz.owner_id == request.auth.uid) ||
        ('ownerId' in biz && biz.ownerId == request.auth.uid)
      );
    }

    function isValidTimestampBinding(data) {
      return ('startTimestamp' in data) &&
             ('startDateTime' in data) &&
             data.startTimestamp is int &&
             data.startDateTime == timestamp.value(data.startTimestamp);
    }

    function isServiceActive(businessId, serviceId) {
      let s = get(/databases/$(database)/documents/businesses/$(businessId)/services/$(serviceId)).data;
      return (!('active' in s) || s.active == true) &&
             (!('isActive' in s) || s.isActive == true) &&
             (!('is_active' in s) || s.is_active == true);
    }

    function isStaffActive(businessId, staffId) {
      let st = get(/databases/$(database)/documents/businesses/$(businessId)/staff/$(staffId)).data;
      return (!('active' in st) || st.active == true) &&
             (!('isActive' in st) || st.isActive == true) &&
             (!('is_active' in st) || st.is_active == true);
    }

    function matchesServicePrice(businessId, serviceId, price) {
      let s = get(/databases/$(database)/documents/businesses/$(businessId)/services/$(serviceId)).data;
      return ('price' in s && s.price == price) ||
             ('servicePrice' in s && s.servicePrice == price) ||
             ('service_price' in s && s.service_price == price);
    }

    // User Devices
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // User Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if false;
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && resource != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'isRead']);
      allow delete: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isUser(userId);

      allow create: if isUser(userId)
                    && request.path == /databases/$(database)/documents/users/$(userId)
                    && request.resource.data.keys().hasAny(['email', 'role'])
                    && request.resource.data.id == userId
                    && ('email' in request.auth.token)
                    && request.resource.data.email == request.auth.token.email
                    && (request.resource.data.role == 'customer' || request.resource.data.role == 'owner');

      allow update: if isUser(userId)
                    && request.path == /databases/$(database)/documents/users/$(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email']);
    }

    // Businesses Collection & Subcollections
    match /businesses/{businessId} {
      allow read: if true;

      allow create: if isOwnerAccount() &&
        (request.resource.data.ownerId == request.auth.uid ||
         request.resource.data.owner_id == request.auth.uid);

      allow update: if isBusinessOwner(businessId);

      allow delete: if isBusinessOwner(businessId);

      // Services Subcollection
      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // Staff Subcollection
      match /staff/{staffId} {
        allow read: if true;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // Offers Subcollection
      match /offers/{offerId} {
        allow read: if true;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // Gallery Subcollection
      match /gallery/{imageId} {
        allow read: if true;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // Owner Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, update: if isBusinessOwner(businessId);
        allow create, delete: if isBusinessOwner(businessId);
      }

      // Staff Time-offs Subcollection
      match /timeOffs/{timeOffId} {
        allow read, create, update, delete: if isBusinessOwner(businessId);
      }

      // PRIVATE OWNER CUSTOMER NOTES SUBCOLLECTION (CUSTOMERS STRICTLY DENIED)
      match /customerNotes/{customerId} {
        allow read, write: if isBusinessOwner(businessId);
      }

      match /bookingNotes/{bookingId} {
        allow read, write: if isBusinessOwner(businessId);
      }
    }

    // Slot Locks Collection
    match /booking_slots/{slotId} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated()
                    && request.resource.data.slotId == slotId
                    && (request.resource.data.customerId == request.auth.uid || isBusinessOwner(request.resource.data.businessId))
                    && isValidTimestampBinding(request.resource.data)
                    && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId));

      allow delete: if isAuthenticated()
                    && (resource.data.customerId == request.auth.uid || isBusinessOwner(resource.data.businessId))
                    && existsAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId))
                    && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == 'cancelled';
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isBusinessOwner(resource.data.businessId)
      );

      allow create: if isAuthenticated()
                    && (request.resource.data.customerId == request.auth.uid || isBusinessOwner(request.resource.data.businessId))
                    && isValidTimestampBinding(request.resource.data)
                    && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId));

      allow update: if isAuthenticated()
                    && (
                      (
                        resource.data.customerId == request.auth.uid
                        && request.resource.data.status == 'cancelled'
                      )
                      ||
                      (
                        resource.data.customerId == request.auth.uid
                        && (resource.data.status == 'pending' || resource.data.status == 'confirmed')
                        && request.resource.data.status == 'pending'
                      )
                      ||
                      (
                        isBusinessOwner(resource.data.businessId)
                      )
                    );

      allow delete: if isBusinessOwner(resource.data.businessId);
    }
  }
}
