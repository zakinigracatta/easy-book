rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdminAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        );
    }

    function isOwnerAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function hasOwnerIdentity(data, userId) {
      return (
        ('owner_id' in data) &&
        data.owner_id == userId
      ) || (
        !('owner_id' in data) &&
        ('ownerId' in data) &&
        data.ownerId == userId
      );
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        hasOwnerIdentity(
          get(/databases/$(database)/documents/businesses/$(businessId)).data,
          request.auth.uid
        );
    }

    function hasVerifiedPublicationState(data) {
      return (
        ('is_verified' in data) &&
        data.is_verified == true
      ) || (
        !('is_verified' in data) &&
        ('isVerified' in data) &&
        data.isVerified == true
      );
    }

    function hasActivePublicationState(data) {
      return (
        ('is_active' in data) &&
        data.is_active == true
      ) || (
        !('is_active' in data) &&
        ('isActive' in data) &&
        data.isActive == true
      );
    }

    function hasBookablePublicationState(data) {
      return (
        ('is_bookable' in data) &&
        data.is_bookable == true
      ) || (
        !('is_bookable' in data) &&
        ('isBookable' in data) &&
        data.isBookable == true
      );
    }

    function isPublishedBusiness(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        hasVerifiedPublicationState(
          get(/databases/$(database)/documents/businesses/$(businessId)).data
        ) &&
        hasActivePublicationState(
          get(/databases/$(database)/documents/businesses/$(businessId)).data
        );
    }

    function validExpenseCategory(category) {
      return category in [
        'rent',
        'salaries',
        'commissions',
        'utilities',
        'internetPhone',
        'supplies',
        'equipment',
        'maintenance',
        'cleaningLaundry',
        'marketing',
        'licensing',
        'insurance',
        'paymentFees',
        'easyBookFees',
        'taxes',
        'transport',
        'other'
      ];
    }

    function validExpenseFrequency(frequency) {
      return frequency in ['oneTime', 'monthly', 'yearly'];
    }

    function serviceBelongsToBusiness(data, businessId) {
      return (!('business_id' in data) || data.business_id == businessId) &&
        (!('businessId' in data) || data.businessId == businessId) &&
        (!('salon_id' in data) || data.salon_id == businessId);
    }

    function serviceIdentityMatches(data, serviceId) {
      return !('id' in data) || data.id == serviceId;
    }

    function staffBelongsToBusiness(data, businessId) {
      return (!('business_id' in data) || data.business_id == businessId) &&
        (!('businessId' in data) || data.businessId == businessId);
    }

    function validNewStaffTrustFields(data) {
      return (!('rating' in data) || data.rating == 0) &&
        (!('review_count' in data) || data.review_count == 0) &&
        (!('reviewCount' in data) || data.reviewCount == 0);
    }

    function preservesStaffTrustFields() {
      return (
          (!('rating' in resource.data) &&
            (!('rating' in request.resource.data) || request.resource.data.rating == 0)) ||
          (('rating' in resource.data) &&
            ('rating' in request.resource.data) &&
            request.resource.data.rating == resource.data.rating)
        ) &&
        (
          (!('review_count' in resource.data) &&
            (
              (!('reviewCount' in resource.data) &&
                (!('review_count' in request.resource.data) || request.resource.data.review_count == 0)) ||
              (('reviewCount' in resource.data) &&
                ('review_count' in request.resource.data) &&
                request.resource.data.review_count == resource.data.reviewCount)
            )) ||
          (('review_count' in resource.data) &&
            ('review_count' in request.resource.data) &&
            request.resource.data.review_count == resource.data.review_count)
        ) &&
        (
          (!('reviewCount' in resource.data) &&
            (!('reviewCount' in request.resource.data) || request.resource.data.reviewCount == 0)) ||
          (('reviewCount' in resource.data) &&
            ('reviewCount' in request.resource.data) &&
            request.resource.data.reviewCount == resource.data.reviewCount)
        );
    }

    function validOfferData(businessId, offerId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'businessId',
          'business_id',
          'title',
          'description',
          'discountType',
          'discount_type',
          'discountValue',
          'discount_value',
          'startDate',
          'start_date',
          'endDate',
          'end_date',
          'serviceIds',
          'service_ids',
          'isActive',
          'is_active',
          'createdAt',
          'created_at'
        ]) &&
        request.resource.data.keys().hasAll([
          'id',
          'businessId',
          'title',
          'description',
          'discountType',
          'discountValue',
          'startDate',
          'endDate',
          'serviceIds',
          'isActive'
        ]) &&
        request.resource.data.id == offerId &&
        request.resource.data.businessId == businessId &&
        (!('business_id' in request.resource.data) ||
          request.resource.data.business_id == businessId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 1000 &&
        request.resource.data.discountType in ['percentage', 'fixed'] &&
        request.resource.data.discountValue is number &&
        request.resource.data.discountValue > 0 &&
        (
          request.resource.data.discountType != 'percentage' ||
          request.resource.data.discountValue <= 100
        ) &&
        request.resource.data.startDate is string &&
        request.resource.data.startDate.size() > 0 &&
        request.resource.data.startDate.size() <= 80 &&
        request.resource.data.endDate is string &&
        request.resource.data.endDate.size() > 0 &&
        request.resource.data.endDate.size() <= 80 &&
        request.resource.data.serviceIds is list &&
        request.resource.data.serviceIds.size() <= 100 &&
        request.resource.data.isActive is bool &&
        (!('createdAt' in request.resource.data) ||
          request.resource.data.createdAt is string);
    }

    function validExpenseData(businessId) {
      return request.resource.data.keys().hasOnly([
          'businessId',
          'category',
          'description',
          'amount',
          'expenseDate',
          'paymentMethod',
          'supplier',
          'receiptUrl',
          'notes',
          'frequency',
          'isActive',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'businessId',
          'category',
          'description',
          'amount',
          'expenseDate',
          'paymentMethod',
          'frequency',
          'isActive',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.businessId == businessId &&
        request.resource.data.category is string &&
        validExpenseCategory(request.resource.data.category) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 300 &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.expenseDate is timestamp &&
        request.resource.data.paymentMethod is string &&
        request.resource.data.paymentMethod.size() > 0 &&
        request.resource.data.frequency is string &&
        validExpenseFrequency(request.resource.data.frequency) &&
        request.resource.data.isActive is bool &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        (!('supplier' in request.resource.data) || request.resource.data.supplier is string) &&
        (!('receiptUrl' in request.resource.data) || request.resource.data.receiptUrl is string) &&
        (!('notes' in request.resource.data) || request.resource.data.notes is string);
    }

    // User Devices
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // User Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if false;
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && resource != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'isRead']);
      allow delete: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isUser(userId) || isAdminAccount();

      allow create: if isUser(userId)
                    && request.path == /databases/$(database)/documents/users/$(userId)
                    && request.resource.data.keys().hasOnly([
                      'id',
                      'email',
                      'full_name',
                      'name',
                      'phone',
                      'avatar_url',
                      'profile_image',
                      'role',
                      'wallet_balance',
                      'walletBalance',
                      'favorite_business_ids',
                      'business_name',
                      'category',
                      'location',
                      'business_image_url',
                      'created_at',
                      'updated_at',
                      'createdAt',
                      'updatedAt'
                    ])
                    && request.resource.data.keys().hasAll(['id', 'email', 'role'])
                    && request.resource.data.id == userId
                    && ('email' in request.auth.token)
                    && request.resource.data.email == request.auth.token.email
                    && (request.resource.data.role == 'customer' || request.resource.data.role == 'owner')
                    && (!('wallet_balance' in request.resource.data) || request.resource.data.wallet_balance == 0)
                    && (!('walletBalance' in request.resource.data) || request.resource.data.walletBalance == 0);

      // Profile updates are intentionally limited to non-authoritative display
      // fields. Role, email, identity, and financial balances are server-owned.
      allow update: if isUser(userId)
                    && request.path == /databases/$(database)/documents/users/$(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'full_name',
                      'name',
                      'phone',
                      'avatar_url',
                      'profile_image',
                      'favorite_business_ids',
                      'business_name',
                      'category',
                      'location',
                      'business_image_url',
                      'updated_at',
                      'updatedAt'
                    ]);

      match /favorites/{businessId} {
        allow read, delete: if isUser(userId);
        allow create: if isUser(userId)
                      && request.resource.data.businessId == businessId
                      && request.resource.data.keys().hasOnly(['businessId', 'createdAt']);
        allow update: if false;
      }
    }

    // Businesses Collection & Subcollections
    match /businesses/{businessId} {
      // Single-document reads can validate ownership through the concrete
      // document path. Collection queries do not have a concrete wildcard ID,
      // so list authorization must be expressed against resource.data instead.
      allow get: if isBusinessOwner(businessId)
                 || isAdminAccount()
                 || (
                   hasVerifiedPublicationState(resource.data)
                   && hasActivePublicationState(resource.data)
                 );

      allow list: if isAdminAccount()
                  || (
                    isAuthenticated()
                    && hasOwnerIdentity(resource.data, request.auth.uid)
                  )
                  || (
                    hasVerifiedPublicationState(resource.data)
                    && hasActivePublicationState(resource.data)
                  );

      allow create: if isOwnerAccount()
                    && hasOwnerIdentity(request.resource.data, request.auth.uid)
                    && (
                      !('ownerId' in request.resource.data)
                      || !('owner_id' in request.resource.data)
                      || request.resource.data.ownerId == request.resource.data.owner_id
                    )
                    && (!('is_verified' in request.resource.data) || request.resource.data.is_verified == false)
                    && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
                    && (!('rating' in request.resource.data) || request.resource.data.rating == 0)
                    && (!('review_count' in request.resource.data) || request.resource.data.review_count == 0)
                    && (!('reviewCount' in request.resource.data) || request.resource.data.reviewCount == 0);

      // Owners may edit operational/profile fields, but cannot self-approve,
      // change platform activation, ownership, rating, or review counters.
      allow update: if (
        isBusinessOwner(businessId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'category',
          'address',
          'description',
          'image_url',
          'imageUrl',
          'latitude',
          'longitude',
          'working_hours',
          'workingHours',
          'amenities',
          'phone',
          'website',
          'gallery_urls',
          'galleryUrls',
          'business_status',
          'businessStatus',
          'accepting_bookings',
          'acceptingBookings',
          'timeZone',
          'timezone',
          'updated_at',
          'updatedAt'
        ])
      ) || (
        isAdminAccount()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'is_verified',
          'isVerified',
          'is_active',
          'isActive',
          'updated_at',
          'updatedAt'
        ])
      );

      // Hard-delete is a platform action. Owners should deactivate content
      // instead so historical bookings keep valid references.
      allow delete: if isAdminAccount();

      match /services/{serviceId} {
        allow read: if isBusinessOwner(businessId)
                    || isAdminAccount()
                    || (
                      isPublishedBusiness(businessId)
                      && hasActivePublicationState(resource.data)
                      && hasBookablePublicationState(resource.data)
                    );
        allow create, update: if isBusinessOwner(businessId)
                              && serviceBelongsToBusiness(
                                request.resource.data,
                                businessId
                              )
                              && serviceIdentityMatches(
                                request.resource.data,
                                serviceId
                              );
        // Preserve historical booking references; owners deactivate services
        // through the repository instead of deleting the document.
        allow delete: if false;
      }

      match /staff/{staffId} {
        allow read: if isBusinessOwner(businessId)
                    || isAdminAccount()
                    || (
                      isPublishedBusiness(businessId)
                      && hasActivePublicationState(resource.data)
                    );
        allow create: if isBusinessOwner(businessId)
                      && staffBelongsToBusiness(request.resource.data, businessId)
                      && validNewStaffTrustFields(request.resource.data);
        allow update: if isBusinessOwner(businessId)
                      && staffBelongsToBusiness(request.resource.data, businessId)
                      && preservesStaffTrustFields();
        // Preserve historical booking references; owners deactivate staff
        // through the repository instead of deleting the document.
        allow delete: if false;
      }

      // PRIVATE OWNER FINANCE: employees and customers have no read/write access.
      match /expenses/{expenseId} {
        allow read: if isBusinessOwner(businessId);

        allow create: if isBusinessOwner(businessId)
                      && validExpenseData(businessId)
                      && request.resource.data.isActive == true
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;

        allow update: if isBusinessOwner(businessId)
                      && resource != null
                      && validExpenseData(businessId)
                      && request.resource.data.businessId == resource.data.businessId
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      match /offers/{offerId} {
        allow read: if isPublishedBusiness(businessId)
                    || isBusinessOwner(businessId)
                    || isAdminAccount();
        allow create, update: if isBusinessOwner(businessId)
                              && validOfferData(businessId, offerId);
        allow delete: if isBusinessOwner(businessId);
      }

      match /gallery/{imageId} {
        allow read: if isPublishedBusiness(businessId)
                    || isBusinessOwner(businessId)
                    || isAdminAccount();
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      match /reviews/{reviewId} {
        allow read: if isPublishedBusiness(businessId)
                    || isBusinessOwner(businessId)
                    || isAdminAccount();
        allow create, delete: if false;
        allow update: if isBusinessOwner(businessId)
                      && resource != null
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['businessReply', 'businessReplyAt'])
                      && request.resource.data.businessReply is string
                      && request.resource.data.businessReply.size() <= 500
                      && request.resource.data.businessReplyAt == request.time;
      }

      match /notifications/{notificationId} {
        allow read, update: if isBusinessOwner(businessId);
        allow create, delete: if isBusinessOwner(businessId);
      }

      // Employee leave is private. Customer availability receives only
      // sanitized start/end intervals through a callable Cloud Function.
      match /timeOffs/{timeOffId} {
        allow read, create, update, delete: if isBusinessOwner(businessId);
      }

      match /customerNotes/{customerId} {
        allow read, write: if isBusinessOwner(businessId);
      }

      match /bookingNotes/{bookingId} {
        allow read, write: if isBusinessOwner(businessId);
      }
    }

    // Slot locks are internal booking-coordination records. Availability is
    // exposed only through the sanitized getAvailabilityBlocks callable.
    match /booking_slots/{slotId} {
      allow read, create, update, delete: if false;
    }

    // Bookings Collection (Untrusted Client Direct Writes Denied; Cloud Functions Admin SDK Execution Canonical)
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isBusinessOwner(resource.data.businessId) ||
        isAdminAccount()
      );

      allow create, update, delete: if false;
    }

    // Admin Configuration (read by admin only; writes provisioned via Admin SDK)
    match /admin_config/{docId} {
      allow read: if isAdminAccount();
      allow write: if false;
    }
  }
}
