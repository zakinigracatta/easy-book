rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdminAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        );
    }

    function isOwnerAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isAdminAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        (
          ('owner_id' in get(/databases/$(database)/documents/businesses/$(businessId)).data && get(/databases/$(database)/documents/businesses/$(businessId)).data.owner_id == request.auth.uid) ||
          ('ownerId' in get(/databases/$(database)/documents/businesses/$(businessId)).data && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid)
        );
    }

    function isPublishedBusiness(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        ('is_verified' in get(/databases/$(database)/documents/businesses/$(businessId)).data) &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.is_verified == true &&
        (!('is_active' in get(/databases/$(database)/documents/businesses/$(businessId)).data) ||
          get(/databases/$(database)/documents/businesses/$(businessId)).data.is_active == true);
    }

    function validExpenseCategory(category) {
      return category in [
        'rent',
        'salaries',
        'commissions',
        'utilities',
        'internetPhone',
        'supplies',
        'equipment',
        'maintenance',
        'cleaningLaundry',
        'marketing',
        'licensing',
        'insurance',
        'paymentFees',
        'easyBookFees',
        'taxes',
        'transport',
        'other'
      ];
    }

    function validExpenseFrequency(frequency) {
      return frequency in ['oneTime', 'monthly', 'yearly'];
    }

    function validExpenseData(businessId) {
      return request.resource.data.keys().hasOnly([
          'businessId',
          'category',
          'description',
          'amount',
          'expenseDate',
          'paymentMethod',
          'supplier',
          'receiptUrl',
          'notes',
          'frequency',
          'isActive',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'businessId',
          'category',
          'description',
          'amount',
          'expenseDate',
          'paymentMethod',
          'frequency',
          'isActive',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.businessId == businessId &&
        request.resource.data.category is string &&
        validExpenseCategory(request.resource.data.category) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 300 &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.expenseDate is timestamp &&
        request.resource.data.paymentMethod is string &&
        request.resource.data.paymentMethod.size() > 0 &&
        request.resource.data.frequency is string &&
        validExpenseFrequency(request.resource.data.frequency) &&
        request.resource.data.isActive is bool &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        (!('supplier' in request.resource.data) || request.resource.data.supplier is string) &&
        (!('receiptUrl' in request.resource.data) || request.resource.data.receiptUrl is string) &&
        (!('notes' in request.resource.data) || request.resource.data.notes is string);
    }

    // User Devices
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // User Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if false;
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && resource != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'isRead']);
      allow delete: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isUser(userId);

      allow create: if isUser(userId)
                    && request.path == /databases/$(database)/documents/users/$(userId)
                    && request.resource.data.keys().hasAny(['email', 'role'])
                    && request.resource.data.id == userId
                    && ('email' in request.auth.token)
                    && request.resource.data.email == request.auth.token.email
                    && (request.resource.data.role == 'customer' || request.resource.data.role == 'owner');

      allow update: if isUser(userId)
                    && request.path == /databases/$(database)/documents/users/$(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email']);

      match /favorites/{businessId} {
        allow read, delete: if isUser(userId);
        allow create: if isUser(userId)
                      && request.resource.data.businessId == businessId
                      && request.resource.data.keys().hasOnly(['businessId', 'createdAt']);
        allow update: if false;
      }
    }

    // Businesses Collection & Subcollections
    match /businesses/{businessId} {
      allow read: if isBusinessOwner(businessId)
                  || isAdminAccount()
                  || (
                    ('is_verified' in resource.data)
                    && resource.data.is_verified == true
                    && (!('is_active' in resource.data) || resource.data.is_active == true)
                  );

      allow create: if isOwnerAccount()
                    && (
                      (('ownerId' in request.resource.data) && request.resource.data.ownerId == request.auth.uid)
                      || (('owner_id' in request.resource.data) && request.resource.data.owner_id == request.auth.uid)
                    )
                    && (!('is_verified' in request.resource.data) || request.resource.data.is_verified == false)
                    && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
                    && (!('rating' in request.resource.data) || request.resource.data.rating == 0)
                    && (!('review_count' in request.resource.data) || request.resource.data.review_count == 0)
                    && (!('reviewCount' in request.resource.data) || request.resource.data.reviewCount == 0);

      // Owners may edit operational/profile fields, but cannot self-approve,
      // change platform activation, ownership, rating, or review counters.
      allow update: if (
        isBusinessOwner(businessId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'category',
          'address',
          'description',
          'image_url',
          'imageUrl',
          'latitude',
          'longitude',
          'working_hours',
          'workingHours',
          'amenities',
          'phone',
          'website',
          'gallery_urls',
          'galleryUrls',
          'business_status',
          'businessStatus',
          'accepting_bookings',
          'acceptingBookings',
          'timeZone',
          'timezone',
          'updated_at',
          'updatedAt'
        ])
      ) || (
        isAdminAccount()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'is_verified',
          'isVerified',
          'is_active',
          'isActive',
          'updated_at',
          'updatedAt'
        ])
      );

      // Hard-delete is a platform action. Owners should deactivate content
      // instead so historical bookings keep valid references.
      allow delete: if isAdminAccount();

      match /services/{serviceId} {
        allow read: if isPublishedBusiness(businessId)
                    || isBusinessOwner(businessId)
                    || isAdminAccount();
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      match /staff/{staffId} {
        allow read: if isPublishedBusiness(businessId)
                    || isBusinessOwner(businessId)
                    || isAdminAccount();
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // PRIVATE OWNER FINANCE: employees and customers have no read/write access.
      match /expenses/{expenseId} {
        allow read: if isBusinessOwner(businessId);

        allow create: if isBusinessOwner(businessId)
                      && validExpenseData(businessId)
                      && request.resource.data.isActive == true
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;

        allow update: if isBusinessOwner(businessId)
                      && resource != null
                      && validExpenseData(businessId)
                      && request.resource.data.businessId == resource.data.businessId
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      match /offers/{offerId} {
        allow read: if isPublishedBusiness(businessId)
                    || isBusinessOwner(businessId)
                    || isAdminAccount();
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      match /gallery/{imageId} {
        allow read: if isPublishedBusiness(businessId)
                    || isBusinessOwner(businessId)
                    || isAdminAccount();
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      match /reviews/{reviewId} {
        allow read: if isPublishedBusiness(businessId)
                    || isBusinessOwner(businessId)
                    || isAdminAccount();
        allow create, delete: if false;
        allow update: if isBusinessOwner(businessId)
                      && resource != null
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['businessReply', 'businessReplyAt']);
      }

      match /notifications/{notificationId} {
        allow read, update: if isBusinessOwner(businessId);
        allow create, delete: if isBusinessOwner(businessId);
      }

      // Employee leave is private. Customer availability receives only
      // sanitized start/end intervals through a callable Cloud Function.
      match /timeOffs/{timeOffId} {
        allow read, create, update, delete: if isBusinessOwner(businessId);
      }

      match /customerNotes/{customerId} {
        allow read, write: if isBusinessOwner(businessId);
      }

      match /bookingNotes/{bookingId} {
        allow read, write: if isBusinessOwner(businessId);
      }
    }

    // Slot locks contain only non-sensitive availability state. Guests may read
    // them so they can browse open appointment times before signing in. All
    // writes remain server-only through trusted backend code.
    match /booking_slots/{slotId} {
      allow read, get, list: if true;
      allow create, update, delete: if false;
    }

    // Bookings Collection (Untrusted Client Direct Writes Denied; Cloud Functions Admin SDK Execution Canonical)
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isBusinessOwner(resource.data.businessId) ||
        isAdminAccount()
      );

      allow create, update, delete: if false;
    }

    // Admin Configuration (read by admin only; writes provisioned via Admin SDK)
    match /admin_config/{docId} {
      allow read: if isAdminAccount();
      allow write: if false;
    }
  }
}
